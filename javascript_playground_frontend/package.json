{
  "name": "javascript-playground-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "A modern JavaScript playground with code editor, live execution, and sharing capabilities",
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "monaco-editor": "^0.45.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  },
  "keywords": [
    "javascript",
    "playground",
    "code-editor",
    "react",
    "monaco-editor",
    "syntax-highlighting"
  ],
  "author": "JavaScript Playground Team",
  "homepage": "."
}
